APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

DATABASE_URL=sqlite:///./citycompass.db
# or: postgresql+psycopg://postgres:password@localhost:5432/citycompass

CITY_NAME=Pune
CITY_LAT=18.5204
CITY_LNG=73.8567
CITY_BBOX=18.44,73.75,18.62,73.96                # south,west,north,east

USE_MOCKS=true            # true = zero API keys needed
ORS_API_KEY=
OPENWEATHER_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=8
RATE_LIMIT_PER_MIN=60
WHISPER_MODEL=base
